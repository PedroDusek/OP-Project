# =========================================================
# OPTCG Collection Manager - environment template
# Copy to .env and fill in real values. NEVER commit .env.
# This file grows as checkpoints are approved.
# =========================================================

# ---- Application ----
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://optcg:CHANGE_ME@localhost:5432/optcg?schema=public

# Separate database used by the automated test suite.
# Migrations are reset against this one, so it must NOT point at dev data.
TEST_DATABASE_URL=postgresql://optcg:CHANGE_ME@localhost:5432/optcg_test?schema=public

# ---- Authentication ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=CHANGE_ME
