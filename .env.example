# =========================================================
# OPTCG Collection Manager - template de ambiente
# Copie para .env e preencha com valores reais. NUNCA versione o .env.
# Este arquivo cresce conforme os checkpoints sao aprovados.
# =========================================================

# ---- Aplicacao ----
# Em producao, na Fly.io (decisao 089): os valores nao secretos ficam em
# fly.toml, os segredos em `fly secrets`, e os NEXT_PUBLIC_* nas variables do
# GitHub, porque entram no build. Ver development.md 6.6.
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- Banco de dados (PostgreSQL) ----
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=postgresql://optcg:TROQUE_ISTO@localhost:5432/optcg?schema=public

# Banco separado usado pela suite de testes de integracao.
# As migrations recriam este banco, entao ele NAO pode apontar para dados de desenvolvimento.
TEST_DATABASE_URL=postgresql://optcg:TROQUE_ISTO@localhost:5432/optcg_test?schema=public

# ---- Supabase, producao (decisao 025) ----
# Projeto criado em supabase.com, regiao South America (Sao Paulo).

# Banco de PRODUCAO. Nunca vira DATABASE_URL: producao e sempre alvo explicito,
# acessada so por `npm run supabase <comando>`. Contem a senha do banco.
# Settings > Database > Connection string > URI (direct connection).
SUPABASE_DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# Autenticacao. A URL e a publishable key sao publicas por design.
# Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TROQUE_ISTO

# SEGREDO. Ignora RLS e da acesso total. Nunca em codigo de cliente, nunca em
# commit, nunca colada em conversa. So preencha quando o Checkpoint 5 precisar.
SUPABASE_SECRET_KEY=

# Bucket das imagens enviadas pelo usuario (foto de local de armazenamento).
# Crie com `npm run supabase storage`. Sem SUPABASE_SECRET_KEY, o envio de
# imagem some da tela e o resto continua funcionando.
SUPABASE_STORAGE_BUCKET=colexa-imagens

# ---- E-mail, Resend (decisao 086) ----
# Cada denuncia da rede chega a suporte@colexa.com.br com o assunto DENUNCIA.
# SEGREDO: a chave do Resend (resend.com > API Keys, permissao "Sending access").
# Vazia: a denuncia so fica gravada no banco, e ninguem e avisado.
RESEND_API_KEY=
# Remetente, de um dominio verificado no Resend.
EMAIL_FROM="ColeXa <nao-responda@colexa.com.br>"

# ---- CAPTCHA, Cloudflare Turnstile (decisao 088) ----
# Chave PUBLICA do widget (Cloudflare > Turnstile). Vazia: sem CAPTCHA na tela.
# A chave secreta NAO vem para ca: vai no painel do Supabase (Attack Protection).
# Ordem: esta chave no ambiente primeiro, o CAPTCHA no painel depois.
# Entra no pacote do navegador no build: mudou, rebuild (ou reinicie o dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Pagamento, Stripe (decisao 102) ----
# SEGREDO: chave secreta da conta (Stripe > Developers > API keys). Vazia: a
# tela de Premium diz que a assinatura nao esta aberta, e nada mais muda.
STRIPE_SECRET_KEY=
# SEGREDO: segredo do endpoint de webhook (Stripe > Developers > Webhooks),
# apontado para https://SEU-SITE/api/pagamentos/stripe. E o que prova que o
# aviso veio da Stripe: sem ele, qualquer POST viraria Premium.
STRIPE_WEBHOOK_SECRET=
# Ids dos precos recorrentes cadastrados na Stripe (R$ 14,90/mes e R$ 149/ano).
# O Pix nao usa preco cadastrado: o valor vai inline, vindo do dominio.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Liga o Pix (1 liga, qualquer outra coisa desliga). Fica desligada: o Pix ficou
# fora do lancamento (decisao 102, mudanca de 21/09), porque a Stripe o libera
# por convite e esperar atrasaria a abertura. O codigo do Pix continua inteiro e
# testado, dormindo atras desta chave. Nao e segredo.
STRIPE_PIX=
# ---- Indexacao por buscadores (decisao 105) ----
# Vazio ou 0: o site pede `noindex` em toda pagina, mesmo no dominio oficial.
# `1`, `true` ou `sim`: libera a indexacao — e so vale em colexa.com.br.
# Ligar e decisao do dono do produto, no dia do lancamento, e nao acompanha a
# troca de dominio. Em producao mora no fly.toml, porque nao e segredo.
ALLOW_INDEXING=