# =========================================================
# OPTCG Collection Manager - template de ambiente
# Copie para .env e preencha com valores reais. NUNCA versione o .env.
# Este arquivo cresce conforme os checkpoints sao aprovados.
# =========================================================

# ---- Aplicacao ----
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- Banco de dados (PostgreSQL) ----
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=postgresql://optcg:TROQUE_ISTO@localhost:5432/optcg?schema=public

# Banco separado usado pela suite de testes de integracao.
# As migrations recriam este banco, entao ele NAO pode apontar para dados de desenvolvimento.
TEST_DATABASE_URL=postgresql://optcg:TROQUE_ISTO@localhost:5432/optcg_test?schema=public

# ---- Autenticacao (Supabase, decisao 025) ----
# Criados ao abrir o projeto em supabase.com, regiao South America (Sao Paulo).
# A URL e a chave anon sao publicas por design; a service role e SEGREDO e nunca
# pode aparecer em codigo do cliente nem em commit.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TROQUE_ISTO
SUPABASE_SERVICE_ROLE_KEY=TROQUE_ISTO
