// Schema do OPTCG Collection Manager.
//
// Implementa as 24 tabelas do modelo logico mais as adicoes estruturais
// aprovadas em docs/decisions.md (008 token publico, 009 Premium e trial,
// 015 exclusao por anonimizacao).
//
// Nomes de tabela e coluna seguem exatamente o modelo logico, em snake_case,
// via @map e @@map. Os nomes em camelCase existem apenas no cliente.
//
// Restricoes CHECK, indices parciais, indices GIN de trigrama e triggers nao
// sao expressaveis no schema do Prisma. Eles vivem em SQL bruto dentro das
// migrations. Ver docs/database.md secao 3.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ---------------------------------------------------------------- identidade

model User {
  id                        BigInt    @id @default(autoincrement())
  name                      String    @db.VarChar(100)
  email                     String    @unique @db.VarChar(255)
  // Identidade no provedor de autenticacao (decisao 025). A senha nunca chega
  // ao nosso banco: quem guarda e verifica credencial e o Supabase. Esta coluna
  // apenas amarra a conta de la a esta linha, que collections, storage_locations
  // e trade_participants referenciam.
  authUserId                String?   @unique @map("auth_user_id") @db.VarChar(64)
  // O nome que outros usuarios veem, unico em toda a rede (decisao 060).
  //
  // Guardado ja em minusculas: e sobre esta forma que a unicidade vale, e
  // guardar como a pessoa digitou criaria dois nomes que o banco aceita e o
  // olho nao distingue.
  //
  // Anulavel porque a conta existe antes de a pessoa escolher: exigir no
  // cadastro poria mais um campo entre alguem e a primeira carta registrada.
  username                  String?   @unique @db.VarChar(20)
  // Quando trocou pela ultima vez. Nulo para quem nunca trocou — e escolher
  // pela primeira vez nao conta, senao alguem que acabou de chegar esperaria
  // uma semana para corrigir um erro de digitacao.
  usernameChangedAt         DateTime? @map("username_changed_at") @db.Timestamptz(6)
  // O Trade Binder publico (decisao 064, que altera a 008).
  //
  // Mora aqui, e nao em `storage_locations`, porque o que se publica e o
  // **conjunto**: todas as copias em locais de troca aparecem como uma colecao
  // so, e nao segmentadas pelo movel em que estao guardadas. Quem recebe o link
  // quer ver o que a pessoa tem para trocar, e a divisao em binder e caixa e
  // organizacao domestica dela.
  //
  // Longo e aleatorio como o convite de troca (decisao 056): quem tem o link ve
  // o inventario de troca de alguem, entao adivinhar um seria bisbilhotar. Nulo
  // enquanto ninguem publicou, e volta a nulo ao revogar.
  tradeBinderToken          String?   @unique @map("trade_binder_token") @db.VarChar(64)
  tradeBinderTokenCreatedAt DateTime? @map("trade_binder_token_created_at") @db.Timestamptz(6)
  plan                      String    @default("FREE") @db.VarChar(20)
  trialStartedAt            DateTime? @map("trial_started_at") @db.Timestamptz(6)
  premiumUntil              DateTime? @map("premium_until") @db.Timestamptz(6)
  deletedAt                 DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  collection        Collection?
  storageLocations  StorageLocation[]
  wantItems         WantItem[]
  tradeParticipants TradeParticipant[]

  @@map("users")
}

model Collection {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@map("collections")
}

// ------------------------------------------------------------------ catalogo

model Card {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique @db.VarChar(20)
  name       String   @db.VarChar(150)
  type       String   @db.VarChar(20)
  cost       Int?
  power      Int?
  life       Int?
  counter    Int?
  hasTrigger Boolean  @default(false) @map("has_trigger")
  blockIcon  String?  @map("block_icon") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants   CardVariant[]
  colors     CardColor[]
  traits     CardTrait[]
  attributes CardAttribute[]
  mechanics  CardMechanic[]
  effects    CardEffect[]

  // Busca por trecho do nome. A busca exata por codigo usa o indice unico de
  // code e nao passa por aqui. Declarado no schema, e nao em SQL bruto, para
  // que o Prisma o gerencie: um indice que ele desconhece vira DROP INDEX na
  // proxima migration gerada.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([type])
  @@map("cards")
}

model CardVariant {
  id          BigInt   @id @default(autoincrement())
  cardId      BigInt   @map("card_id")
  variantType String   @map("variant_type") @db.VarChar(50)
  rarity      String?  @db.VarChar(50)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  // Identificador externo, decisao 019. Nao substitui a chave primaria e nunca
  // e exposto publicamente: existe so para a importacao ser deterministica.
  // Para dados da Bandai, sourceId e o id por arte, como "OP01-016_p3".
  source      String?  @db.VarChar(30)
  sourceId    String?  @map("source_id") @db.VarChar(60)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Deliberadamente sem @@unique([cardId, variantType]): uma mesma carta possui
  // varias alternate arts distintas com o mesmo variant_type.
  // Ver docs/database.md secao 6.1.
  card            Card                   @relation(fields: [cardId], references: [id], onDelete: Restrict)
  printings       VariantPrinting[]
  prices          CardPrice[]
  collectionItems CollectionItem[]
  wantItems       WantItem[]
  tradeItems      TradeItem[]
  sourceProducts  VariantSourceProduct[]

  @@unique([source, sourceId])
  @@index([cardId])
  @@index([rarity])
  @@index([variantType])
  @@map("card_variants")
}

model Set {
  id   BigInt @id @default(autoincrement())
  code String @unique @db.VarChar(20)
  name String @db.VarChar(150)

  printings VariantPrinting[]

  @@map("sets")
}

model VariantPrinting {
  cardVariantId BigInt @map("card_variant_id")
  setId         BigInt @map("set_id")

  cardVariant CardVariant @relation(fields: [cardVariantId], references: [id], onDelete: Cascade)
  set         Set         @relation(fields: [setId], references: [id], onDelete: Restrict)

  @@id([cardVariantId, setId])
  @@index([setId])
  @@map("variant_printings")
}

// ---------------------------------------------------------------- vocabulario

model Color {
  id   BigInt @id @default(autoincrement())
  name String @unique @db.VarChar(50)

  cards CardColor[]

  @@map("colors")
}

model Trait {
  id   BigInt @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  cards CardTrait[]

  @@map("traits")
}

model Attribute {
  id   BigInt @id @default(autoincrement())
  name String @unique @db.VarChar(50)

  cards CardAttribute[]

  @@map("attributes")
}

model Mechanic {
  id   BigInt @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  cards CardMechanic[]

  @@map("mechanics")
}

model Effect {
  id   BigInt @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  cards CardEffect[]

  @@map("effects")
}

model CardColor {
  cardId  BigInt @map("card_id")
  colorId BigInt @map("color_id")

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  color Color @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@id([cardId, colorId])
  @@index([colorId])
  @@map("card_colors")
}

model CardTrait {
  cardId  BigInt @map("card_id")
  traitId BigInt @map("trait_id")

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  trait Trait @relation(fields: [traitId], references: [id], onDelete: Restrict)

  @@id([cardId, traitId])
  @@index([traitId])
  @@map("card_traits")
}

model CardAttribute {
  cardId      BigInt @map("card_id")
  attributeId BigInt @map("attribute_id")

  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([cardId, attributeId])
  @@index([attributeId])
  @@map("card_attributes")
}

model CardMechanic {
  cardId     BigInt @map("card_id")
  mechanicId BigInt @map("mechanic_id")

  card     Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  mechanic Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Restrict)

  @@id([cardId, mechanicId])
  @@index([mechanicId])
  @@map("card_mechanics")
}

model CardEffect {
  cardId   BigInt @map("card_id")
  effectId BigInt @map("effect_id")

  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  effect Effect @relation(fields: [effectId], references: [id], onDelete: Restrict)

  @@id([cardId, effectId])
  @@index([effectId])
  @@map("card_effects")
}

// --------------------------------------------------------------------- posse

model CollectionItem {
  id            BigInt @id @default(autoincrement())
  collectionId  BigInt @map("collection_id")
  cardVariantId BigInt @map("card_variant_id")
  quantity      Int

  collection  Collection               @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  cardVariant CardVariant              @relation(fields: [cardVariantId], references: [id], onDelete: Restrict)
  locations   CollectionItemLocation[]

  @@unique([collectionId, cardVariantId])
  @@index([cardVariantId])
  @@map("collection_items")
}

model StorageLocation {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  image       String?  @db.VarChar(500)
  type        String   @db.VarChar(20)
  purpose     String?  @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations    CollectionItemLocation[]
  tradeOrigins TradeItemOrigin[]

  @@index([userId])
  @@map("storage_locations")
}

model CollectionItemLocation {
  id                BigInt @id @default(autoincrement())
  collectionItemId  BigInt @map("collection_item_id")
  storageLocationId BigInt @map("storage_location_id")
  quantity          Int

  collectionItem  CollectionItem  @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)

  @@unique([collectionItemId, storageLocationId])
  @@index([storageLocationId])
  @@map("collection_item_locations")
}

model WantItem {
  id            BigInt @id @default(autoincrement())
  userId        BigInt @map("user_id")
  cardVariantId BigInt @map("card_variant_id")
  quantity      Int

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardVariant CardVariant @relation(fields: [cardVariantId], references: [id], onDelete: Restrict)

  @@unique([userId, cardVariantId])
  @@index([cardVariantId])
  @@map("want_items")
}

// -------------------------------------------------------------------- precos

model CardPrice {
  id            BigInt   @id @default(autoincrement())
  cardVariantId BigInt   @map("card_variant_id")
  value         Decimal  @db.Decimal(12, 2)
  capturedAt    DateTime @map("captured_at") @db.Timestamptz(6)

  cardVariant CardVariant @relation(fields: [cardVariantId], references: [id], onDelete: Restrict)

  // Uma captura por variante por instante. Sem isto, reexecutar a importacao de
  // precos duplicaria o historico, e o valor historico de um trade passaria a
  // depender de qual linha a consulta escolhesse.
  //
  // Este unico substitui o indice de consulta que existia antes em
  // (card_variant_id, captured_at DESC): um btree ascendente e varrido para tras
  // pelo PostgreSQL, entao ele ja atende "preco mais recente desta variante".
  // Manter os dois custaria escrita e espaco sem ganho de leitura.
  @@unique([cardVariantId, capturedAt])
  @@map("card_prices")
}

// Qual produto da fonte de preco e esta arte nossa (decisao 053).
//
// A arte comum nao precisa desta tabela: a regra da decisao 050 identifica ela
// sozinha, sem ambiguidade, e uma linha gravada aqui envelheceria mal quando a
// fonte mudasse. O que precisa e a **paralela**, porque o nosso catalogo so
// separa Normal de Parallel (decisao 023) e nao sabe qual paralela e qual.
//
// `origin` e o que torna isto sustentavel. Vinculo `automatic` sai de uma regra
// e pode ser refeito a qualquer momento; `manual` sai do julgamento do dono do
// produto e **nunca** e sobrescrito por regra nenhuma. Sem essa distincao, a
// primeira rederivacao apagaria o trabalho manual.
model VariantSourceProduct {
  id              BigInt   @id @default(autoincrement())
  cardVariantId   BigInt   @map("card_variant_id")
  source          String   @db.VarChar(40)
  /**
   * O id do produto na fonte. Texto, porque nem toda fonte usa numero.
   */
  sourceProductId String   @map("source_product_id") @db.VarChar(60)
  origin          String   @db.VarChar(20)
  confirmedAt     DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(6)

  // Cascade como variant_printings, e nao Restrict como card_prices: isto e
  // dado derivado do catalogo, sem valor historico proprio. Variante que sai do
  // catalogo leva o vinculo junto.
  cardVariant CardVariant @relation(fields: [cardVariantId], references: [id], onDelete: Cascade)

  // Uma arte aponta para um produto so, e um produto pertence a uma arte so. O
  // segundo unico e o que impede dois vinculos manuais para o mesmo produto —
  // erro facil de cometer mapeando centenas de cartas a mao.
  @@unique([cardVariantId, source])
  @@unique([source, sourceProductId])
  @@map("variant_source_products")
}

// Cotacao de moeda, uma linha por par por dia (decisao 051).
//
// Existe porque o preco vem em dolar e a tela mostra tambem em real: sem
// guardar a taxa, o valor em real de um trade passado mudaria toda vez que o
// cambio mexesse, e a regra 5.1 diz que valor historico nao muda.
//
// A data e a da cotacao, nao a da captura. O PTAX so existe em dia util: no
// sabado vale a de sexta, e e a linha de sexta que a consulta encontra.
model ExchangeRate {
  id            BigInt   @id @default(autoincrement())
  baseCurrency  String   @map("base_currency") @db.VarChar(3)
  quoteCurrency String   @map("quote_currency") @db.VarChar(3)
  quoteDate     DateTime @map("quote_date") @db.Date
  rate          Decimal  @db.Decimal(18, 6)
  source        String   @db.VarChar(40)
  capturedAt    DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  // Uma cotacao por par por dia. Reexecutar a importacao no mesmo dia atualiza
  // a linha em vez de criar uma segunda, que faria "a cotacao de hoje" depender
  // de qual delas a consulta escolhesse.
  @@unique([baseCurrency, quoteCurrency, quoteDate])
  @@map("exchange_rates")
}

// Registro de cada importacao de precos (decisao 051).
//
// Existe por dois motivos. O primeiro e a tela: card_prices so ganha linha
// quando o valor muda, entao sem este registro nao ha como dizer "conferido
// hoje as 04:00" — so "sem mudanca desde tal dia", que e outra afirmacao.
//
// O segundo e a observabilidade que integrations.md secao 4 pede desde o
// inicio e que nunca teve onde morar.
model PriceImport {
  id              BigInt    @id @default(autoincrement())
  source          String    @db.VarChar(40)
  // O carimbo que a propria fonte publica. O nosso horario diz quando
  // conferimos; este diz de quando e o dado do mercado, que nao e a mesma coisa
  // — o espelho publica as 20:00 UTC e a importacao roda de madrugada.
  sourceUpdatedAt DateTime? @map("source_updated_at") @db.Timestamptz(6)
  startedAt       DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  fetched         Int       @default(0)
  matched         Int       @default(0)
  written         Int       @default(0)
  unchanged       Int       @default(0)
  unknownCodes    Int       @default(0) @map("unknown_codes")
  // Mensagem do erro quando a importacao nao terminou. Nulo em execucao que
  // deu certo; sem isto, falha silenciosa vira preco velho na tela sem aviso.
  failure         String?   @db.VarChar(500)

  // A tela pergunta sempre a mesma coisa: qual foi a ultima que terminou.
  @@index([finishedAt])
  @@map("price_imports")
}

// -------------------------------------------------------------------- trocas

model Trade {
  id          BigInt    @id @default(autoincrement())
  status      String    @db.VarChar(30)
  // O convite que deixa a segunda pessoa entrar (decisao 056).
  //
  // E o consentimento dela que abre o dado privado dos dois (regra 4.6.1),
  // entao quem tem este token entra numa negociacao onde vera o cruzamento do
  // Trade Binder e da want list de quem convidou. Por isso ele e longo e
  // aleatorio, como o token do Trade Binder publico (decisao 008), e nao um
  // codigo curto de digitar: adivinhar um seria entrar na troca de estranhos.
  //
  // Nulo depois que a segunda pessoa entra: o convite serviu, e um link que
  // continua valendo e um link que ainda pode vazar.
  inviteToken String?   @unique @map("invite_token") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  participants TradeParticipant[]

  @@index([status])
  @@map("trades")
}

model TradeParticipant {
  id                BigInt    @id @default(autoincrement())
  tradeId           BigInt    @map("trade_id")
  userId            BigInt    @map("user_id")
  role              String    @db.VarChar(30)
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(6)
  // Quando a **outra** pessoa alterou a troca depois desta ter confirmado.
  //
  // Sem isto o aviso da regra 4.6.3 seria impossivel: a alteracao revoga as
  // confirmacoes, e depois disso nada no estado lembra que houve o que revogar.
  // A tela diria "confirme" como se fosse a primeira vez, e a pessoa nao saberia
  // que o combinado mudou.
  //
  // Nao guarda quem alterou porque nao precisa: um trade tem exatamente dois
  // participantes (regra 4.5), e a propria alteracao de alguem nunca pede
  // revisao a ele mesmo — quem alterou sabe o que fez. Se este campo esta
  // preenchido, foi o outro.
  reviewRequestedAt DateTime? @map("review_requested_at") @db.Timestamptz(6)
  // Quando esta pessoa marcou que as cartas trocaram de mao de verdade.
  //
  // Nao e a mesma coisa que `confirmed_at`, e juntar as duas apagaria um estado
  // que a regra 4.5 exige. Confirmar e concordar com a oferta que esta na tela;
  // marcar e dizer que o encontro aconteceu e as cartas mudaram de dono. Entre
  // um e outro pode passar uma semana, e nesse meio a troca descansa em
  // `CONFIRMED` — que e exatamente o estado que existiria para nada se
  // confirmar ja concluisse.
  //
  // Os dois marcam (decisao 062). Ninguem tem a colecao mexida sem o proprio
  // gesto, e cada um responde pelas proprias copias a pergunta da regra 4.6.
  exchangedAt       DateTime? @map("exchanged_at") @db.Timestamptz(6)

  trade Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items TradeItem[]

  @@unique([tradeId, userId])
  @@index([userId])
  @@map("trade_participants")
}

model TradeItem {
  id                 BigInt @id @default(autoincrement())
  tradeParticipantId BigInt @map("trade_participant_id")
  cardVariantId      BigInt @map("card_variant_id")
  quantity           Int

  tradeParticipant TradeParticipant  @relation(fields: [tradeParticipantId], references: [id], onDelete: Cascade)
  cardVariant      CardVariant       @relation(fields: [cardVariantId], references: [id], onDelete: Restrict)
  origins          TradeItemOrigin[]

  @@unique([tradeParticipantId, cardVariantId])
  @@index([cardVariantId])
  @@map("trade_items")
}

// De qual local de troca saem quantas copias deste item da oferta.
//
// Existe por causa de uma janela de tempo. A regra 4.7 manda concluir numa
// unica transacao, e a 4.6 manda cada um dizer de onde saem as **proprias**
// copias quando ha escolha real. Como os dois marcam (decisao 062), quem marca
// primeiro responde hoje e a transacao so roda quando o outro marcar — a
// resposta precisa sobreviver no meio, e nao ha onde guarda-la senao aqui.
//
// Uma coluna so nao serviria: quem oferece duas copias com uma em cada binder
// de troca precisa dizer "uma daqui, uma dali", e isso e um para N. O formato e
// o mesmo de `collection_item_locations`, de proposito — e a mesma pergunta.
//
// Fica vazia quando a origem se deduz (copias num local de troca so, ou todas
// saindo), que e a maioria dos casos. Ausencia aqui significa "deduza", e nao
// "sem origem".
model TradeItemOrigin {
  id                BigInt @id @default(autoincrement())
  tradeItemId       BigInt @map("trade_item_id")
  storageLocationId BigInt @map("storage_location_id")
  quantity          Int

  tradeItem       TradeItem       @relation(fields: [tradeItemId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)

  @@unique([tradeItemId, storageLocationId])
  @@index([storageLocationId])
  @@map("trade_item_origins")
}
